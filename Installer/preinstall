#!/bin/zsh
set -euo pipefail
fail() { print -u2 -- "$1"; exit 1; }
[[ "${3:-/}" == / ]] || fail '请安装到当前启动磁盘。'
# Rendered by package.sh. Detect physical Apple Silicon even under Rosetta.
package_arch='@REMOTE_VIBE_ARCH@'
machine_arch=$(/usr/bin/uname -m)
if [[ "$(/usr/sbin/sysctl -n hw.optional.arm64 2>/dev/null || true)" == 1 ]]; then
  machine_arch=arm64
fi
[[ "$package_arch" == arm64 || "$package_arch" == x86_64 ]] || fail '安装包架构信息无效。'
[[ "$machine_arch" == "$package_arch" ]] || fail '本安装包不适用于这台 Mac 的芯片，请下载对应的 Apple Silicon 或 Intel 安装包。'
os_version=$(/usr/bin/sw_vers -productVersion)
(( ${os_version%%.*} >= 15 )) || fail '需要 macOS 15 或更新版本。'
# 如果旧版 App 正在运行，先平滑退出，避免安装覆盖时文件冲突
if /usr/bin/pgrep -x RemoteVibe >/dev/null; then
  /usr/bin/killall RemoteVibe 2>/dev/null || true
  sleep 0.5
  if /usr/bin/pgrep -x RemoteVibe >/dev/null; then
    /usr/bin/killall -9 RemoteVibe 2>/dev/null || true
  fi
fi

# 检查目标路径；若存在旧版组件则安全备份，支持无缝覆盖升级
targets=('/Applications/Remote Vibe.app' '/Library/Audio/Plug-Ins/HAL/RemoteVibeMic.driver')
identifiers=(local.ben.RemoteVibe local.ben.RemoteVibeMic)
present=()
for index in 1 2; do
  bundle="${targets[$index]}"
  [[ ! -e "$bundle" && ! -L "$bundle" ]] && continue
  [[ ! -L "$bundle" && -d "$bundle" ]] || fail "目标路径异常，未覆盖：$bundle"
  identifier=$(/usr/libexec/PlistBuddy -c 'Print CFBundleIdentifier' "$bundle/Contents/Info.plist" 2>/dev/null) || fail "无法识别已有组件，未覆盖：$bundle"
  [[ "$identifier" == "${identifiers[$index]}" ]] || fail "已有同名其他应用，未覆盖：$bundle"
  present+=("$bundle")
done

if (( ${#present} > 0 )); then
  backup_parent='/Users/Shared/RemoteVibe-Uninstalled'
  console_uid=$(/usr/bin/stat -f '%u' /dev/console 2>/dev/null || echo 0)
  if [[ -e "$backup_parent" || -L "$backup_parent" ]]; then
    [[ ! -L "$backup_parent" && -d "$backup_parent" ]] || fail "备份目录异常：$backup_parent"
    parent_uid=$(/usr/bin/stat -f '%u' "$backup_parent")
    if (( parent_uid != 0 && parent_uid != console_uid )); then
      fail "备份目录所有权异常：$backup_parent"
    fi
  else
    /bin/mkdir -m 755 "$backup_parent"
  fi
  /bin/chmod 755 "$backup_parent"
  backup=$(/usr/bin/mktemp -d "$backup_parent/backup-$(date +%Y%m%d-%H%M%S).XXXXXX")
  for bundle in "${present[@]}"; do
    /bin/mv "$bundle" "$backup/"
  done
  if (( console_uid >= 501 )); then
    /usr/sbin/chown -R "$console_uid":staff "$backup" 2>/dev/null || true
  fi
fi
