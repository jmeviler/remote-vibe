#!/bin/zsh
set -euo pipefail
/usr/bin/codesign --verify --deep --strict '/Applications/Remote Vibe.app'
/usr/bin/codesign --verify --deep --strict '/Library/Audio/Plug-Ins/HAL/RemoteVibeMic.driver'
/usr/bin/killall coreaudiod 2>/dev/null || true
console_user=$(/usr/bin/stat -f '%Su' /dev/console)
console_uid=$(/usr/bin/stat -f '%u' /dev/console)
if [[ "$console_user" != root && "$console_user" != loginwindow ]] && (( console_uid >= 501 )); then
  /bin/launchctl asuser "$console_uid" /usr/bin/sudo -u "$console_user" /usr/bin/open '/Applications/Remote Vibe.app' || true
fi
exit 0
